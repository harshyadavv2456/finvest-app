{
  "name": "finvest",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FinVest - Unified Financial Operating System",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "build:strict": "tsc && vite build",
    "build:safe": "npm run test:authority && npm run build",
    "preview": "vite preview",
    "serve": "npx serve -s dist -l 5173",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:authority": "vitest run src/tests/authority --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "system:smoke": "vitest run src/debug/smokeTest.ts --reporter=verbose",
    "system:verify": "vitest run src/debug/realityConvergence.ts --reporter=verbose",
    "system:walkthrough": "vitest run src/debug/EndToEndAuthorityWalkthrough.ts --reporter=verbose",
    "system:coverage": "vitest run src/debug/AuthorityCoverageProbe.ts --reporter=verbose",
    "system:killswitch": "vitest run src/debug/KillSwitchRealityTest.ts --reporter=verbose",
    "system:shutdown:demo": "vitest run src/debug/ShutdownDemo.ts --reporter=verbose",
    "system:final-proof": "vitest run src/debug/FinalProof.ts --reporter=verbose",
    "system:verify-constitution": "vitest run src/verification/ConstitutionVerifier.ts --reporter=verbose",
    "system:generate-bundle": "vitest run src/verification/ReplayBundleGenerator.ts --reporter=verbose",
    "system:hostility": "vitest run src/debug/HostilitySimulator.ts --reporter=verbose",
    "system:replay-check": "vitest run src/debug/ReplayIntegrityCheck.ts --reporter=verbose",
    "verify:everything": "vitest run src/debug/VerifyEverything.ts --reporter=verbose",
    "system:status": "echo 'Open http://localhost:3000/system/status in browser'",
    "positions:daily-sim": "vitest run src/positions/DailySimulation.ts --reporter=verbose",
    "positions:daily-live": "vitest run src/positions/DailySimulation.ts --reporter=verbose -- --mode=live",
    "test:positions": "vitest run src/tests/positions/ --reporter=verbose"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "lightweight-charts": "^5.0.9",
    "lucide-react": "^0.427.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.2",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.6.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^1.6.0"
  }
}
